# Never commit real passwords or secrets.
# The application reads SMS_CONNECTION_STRING first; if it is not set it falls back to
# StduentManagementSystem/appsettings.json (Windows authentication to local SQL Server Express).
#
# Windows (PowerShell):  setx SMS_CONNECTION_STRING "Server=...;Database=...;User Id=...;Password=...;TrustServerCertificate=True;"
#
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=StudentManagementSystem
DB_USER=
DB_PASSWORD=
SMS_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=StudentManagementSystem;Trusted_Connection=True;TrustServerCertificate=True;
